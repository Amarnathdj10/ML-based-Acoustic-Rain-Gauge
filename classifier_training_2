    "# ─────────────────────────────────────────────\n",
    "# Cell 3 — Create 3-class target\n",
    "# ─────────────────────────────────────────────\n",
    "# Thresholds chosen from audit_report_v1 distribution:\n",
    "#   0mm        → No Rain    (class 0)  ~75%\n",
    "#   0 < mm ≤ 1 → Light Rain (class 1)  ~23%\n",
    "#   mm > 1     → Heavy Rain (class 2)  ~2%\n",
    "\n",
    "LIGHT_THRESH = 2.0  # mm per 3-min window\n",
    "HEAVY_THRESH = 2.0\n",
    "\n",
    "def make_label(mm):\n",
    "    if mm == 0:        return 0\n",
    "    elif mm <= LIGHT_THRESH: return 1\n",
    "    else:              return 2\n",
    "\n",
    "df[\"label\"] = df[\"rainfall_mm\"].apply(make_label)\n",
    "\n",
    "CLASS_NAMES = {0: \"No Rain\", 1: \"Light Rain\", 2: \"Heavy Rain\"}\n",
    "print(\"Class distribution:\")\n",
    "for k, v in df[\"label\"].value_counts().sort_index().items():\n",
    "    print(f\"  {CLASS_NAMES[k]:12s}  {v:6d}  ({v/len(df)*100:.1f}%)\")"
   ]
  },
