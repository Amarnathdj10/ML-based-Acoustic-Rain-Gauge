    "print(f\"Feature columns: {len(FEATURE_COLS)}\")\n",
    "\n",
    "df = df.dropna(subset=FEATURE_COLS).reset_index(drop=True)\n",
    "print(f\"Rows after dropna: {len(df)}\")\n",
    "\n",
    "X = df[FEATURE_COLS].values\n",
    "y = df[\"label\"].values"
