    "# ─────────────────────────────────────────────\n",
    "# Cell 2 — Load all monthly parquets directly\n",
    "# ─────────────────────────────────────────────\n",
    "FEATURES_PATH = \"/kaggle/input/datasets/amarnathdj/classifier-features\"\n",
    "files = sorted(glob.glob(FEATURES_PATH + \"/features_*.parquet\"))\n",
    "files = [f for f in files if \"combined\" not in f]\n",
    "print(f\"Found {len(files)} files\")\n",
    "\n",
    "dfs = []\n",
    "for f in files:\n",
    "    tmp = pd.read_parquet(f)\n",
    "    month = f.split(\"features_\")[-1].replace(\".parquet\", \"\")\n",
    "    tmp[\"source_month\"] = month\n",
    "    dfs.append(tmp)\n",
    "    print(f\"  {month:30s}  {tmp.shape}\")\n",
    "\n",
    "df = pd.concat(dfs, ignore_index=True)\n",
    "df = df.sort_values(\"timestamp\").reset_index(drop=True)\n",
    "print(f\"\\nCombined shape : {df.shape}\")\n",
    "print(f\"Date range     : {df['timestamp'].min().date()} → {df['timestamp'].max().date()}\")"
   ]
