    "# ─────────────────────────────────────────────\n",
    "# Cell 5 — Scale + THE LOOPHOLE\n",
    "# ─────────────────────────────────────────────\n",
    "# THE LOOPHOLE: compute_sample_weight(\"balanced\")\n",
    "# Gives each sample a weight inversely proportional to class frequency.\n",
    "# Heavy rain samples (~2%) get ~37x more weight than no-rain samples.\n",
    "# No resampling needed. Works natively with XGBoost's sample_weight param.\n",
    "\n",
    "scaler = StandardScaler()\n",
    "X_scaled = scaler.fit_transform(X)\n",
    "joblib.dump(scaler, f\"{OUTPUT_DIR}/scaler_3class.pkl\")\n",
    "print(\"Scaler saved.\")\n",
    "\n",
    "sample_weights = compute_sample_weight(class_weight=\"balanced\", y=y)\n",
    "print(f\"Weight per class:\")\n",
    "for k in [0, 1, 2]:\n",
    "    mask = y == k\n",
    "    print(f\"  {CLASS_NAMES[k]:12s}: {sample_weights[mask].mean():.3f}\")"
   ]
