    "# ─────────────────────────────────────────────\n",
    "# Cell 4 — Feature cols + clean\n",
    "# ─────────────────────────────────────────────\n",
    "META_COLS = [\"timestamp\", \"rainfall_mm\", \"wav_count\", \"rain\",\n",
    "             \"n_clips_used\", \"0_mean\", \"0_std\", \"source_month\", \"label\"]\n",
