    "cv_mask   = np.zeros(len(y), dtype=bool)\n",
    "\n",
    "for fold, (tr_idx, val_idx) in enumerate(tscv.split(X_scaled)):\n",
    "    X_tr, X_val = X_scaled[tr_idx], X_scaled[val_idx]\n",
    "    y_tr, y_val = y[tr_idx], y[val_idx]\n",
    "    sw_tr       = sample_weights[tr_idx]\n",
    "\n",
    "    fold_model = xgb.XGBClassifier(**best_params)\n",
    "    fold_model.fit(X_tr, y_tr, sample_weight=sw_tr, verbose=False)\n",
    "\n",
    "    preds = fold_model.predict(X_val)\n",
    "    all_preds[val_idx] = preds\n",
    "    cv_mask[val_idx]   = True\n",
    "\n",
    "    f1 = f1_score(y_val, preds, average=\"macro\", zero_division=0)\n",
    "    print(f\"Fold {fold+1}: Macro-F1={f1:.4f}  \"\n",
    "          f\"val_size={len(val_idx)}  \"\n",
    "          f\"rain%={(y_val>0).mean()*100:.1f}\")\n",
    "\n",
    "y_cv     = y[cv_mask]\n",
    "preds_cv = all_preds[cv_mask]\n",
    "\n",
    "print(\"\\n============================================================\")\n",
    "print(\"CV CLASSIFICATION REPORT\")\n",
    "print(\"============================================================\")\n",
    "print(classification_report(y_cv, preds_cv,\n",
    "      target_names=[\"No Rain\", \"Light Rain\", \"Heavy Rain\"],\n",
    "      zero_division=0))\n",
    "print(f\"Balanced Accuracy : {balanced_accuracy_score(y_cv, preds_cv):.4f}\")\n",
    "print(f\"Macro F1          : {f1_score(y_cv, preds_cv, average='macro', zero_division=0):.4f}\")"
   ]
