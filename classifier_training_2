    "# ============================================================\n",
    "# Cell 3 — Create 3-Class Labels\n",
    "# ============================================================\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Thresholds\n",
    "# ------------------------------------------------------------\n",
    "# Class 0 : No Rain\n",
    "# Class 1 : Light Rain\n",
    "# Class 2 : Heavy Rain\n",
    "#\n",
    "# Feel free to modify ONLY these two values for experiments.\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "SILENT_THRESH = 0.0\n",
    "HEAVY_THRESH = 2.0\n",
    "\n",
    "assert HEAVY_THRESH > SILENT_THRESH, \\\n",
    "    \"HEAVY_THRESH must be greater than SILENT_THRESH\"\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Label generation\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "def make_label(mm):\n",
    "\n",
    "    if mm <= SILENT_THRESH:\n",
    "        return 0\n",
    "\n",
    "    elif mm <= HEAVY_THRESH:\n",
    "        return 1\n",
    "\n",
    "    else:\n",
    "        return 2\n",
    "\n",
    "\n",
    "df[\"label\"] = df[\"rainfall_mm\"].apply(make_label)\n",
    "\n",
    "CLASS_NAMES = {\n",
    "    0: \"No Rain\",\n",
    "    1: \"Light Rain\",\n",
    "    2: \"Heavy Rain\"\n",
    "}\n",
    "\n",
    "counts = (\n",
    "    df[\"label\"]\n",
    "    .value_counts()\n",
    "    .sort_index()\n",
    ")\n",
    "\n",
    "print(\"==============================\")\n",
    "print(\"Class Distribution\")\n",
    "print(\"==============================\")\n",
    "\n",
    "for cls, count in counts.items():\n",
    "\n",
    "    print(\n",
    "        f\"{CLASS_NAMES[cls]:12s}\"\n",
    "        f\"{count:8d}\"\n",
    "        f\" ({100*count/len(df):5.2f}%)\"\n",
    "    )\n",
    "\n",
    "print()\n",
    "\n",
    "print(\n",
    "    f\"Ratio (No : Light : Heavy) = \"\n",
    "    f\"{counts[0]//counts[2]} : \"\n",
    "    f\"{counts[1]//counts[2]} : 1\"\n",
    ")"
